# Copy to .env for local (non-docker-compose) development.
# docker-compose.yml reads GROQ_API_KEY etc. from your shell env or a .env
# file in the project root automatically.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glitrai
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for currently served models;
# Groq decommissions them periodically (llama-3.3-70b-versatile is gone).
GROQ_MODEL=openai/gpt-oss-120b
APP_BASE_URL=http://localhost:8000

# Image backend: "pollinations" (default, keyless) or "comfyui".
# "comfyui" only takes effect for jobs that include a reference image; it
# automatically falls back to pollinations on any failure (including no
# reference image, or COMFYUI_BASE_URL unset).
IMAGE_BACKEND=pollinations
# Public URL of your ComfyUI instance's API (e.g. a Colab cloudflared tunnel
# URL from comfyui/colab_setup.ipynb). This is ephemeral on free Colab and
# changes on every restart.
COMFYUI_BASE_URL=
